<view class="custom-tab-bar-root">
	<view class="custom-tab-bar-inner">
		<view class="tab-item {{selected === 0 ? 'active' : ''}}" data-index="0" bindtap="onTabTap">
			<text>首页</text>
		</view>
		<view class="tab-item {{selected === 1 ? 'active' : ''}}" data-index="1" bindtap="onTabTap">
			<text>自营</text>
		</view>
		<view class="tab-fab-slot">
			<view class="fab-bg">
				<image class="fab-img" src="/static/fabu.png" mode="aspectFit"></image>
			</view>
		</view>
		<view class="tab-item tab-item-msg {{selected === 2 ? 'active' : ''}}" data-index="2" bindtap="onTabTap">
			<view class="tab-label-wrap">
				<text>消息</text>
				<view wx:if="{{unreadCount > 0}}" class="msg-dot"><text>{{unreadCount > 99 ? '99+' : unreadCount}}</text></view>
			</view>
		</view>
		<view class="tab-item {{selected === 3 ? 'active' : ''}}" data-index="3" bindtap="onTabTap">
			<text>我</text>
		</view>
	</view>
</view>
