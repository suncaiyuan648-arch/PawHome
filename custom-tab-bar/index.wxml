<view class="custom-tab-bar-root">
	<view class="publish-overlay {{showPublishPanel ? 'publish-overlay--open' : ''}}">
		<view class="publish-mask" bindtap="onPublishMaskTap" catchtouchmove="noop"></view>
		<view class="publish-sheet" catchtap="noop">
			<view class="publish-sheet-head">
				<text class="publish-sheet-title">发布动态</text>
				<view class="publish-sheet-close" bindtap="onPublishClose"><text>×</text></view>
			</view>
			<view class="publish-action publish-action--primary" bindtap="onPublishPost">
				<view class="publish-action-title-row">
					<text class="publish-action-title">发动态</text>
					<image class="publish-action-arrow" src="/static/youjiantou.png" mode="aspectFit"></image>
				</view>
				<text class="publish-action-desc">院主院主，快来更新小院的动态吧</text>
			</view>
			<view class="publish-option-row">
				<view class="publish-option-column" bindtap="onPublishCatYard">
					<text class="publish-option-label">创建小院</text>
					<view class="publish-option publish-option--cat">
						<view class="publish-option-title-row"><text>流浪动物小院</text><image src="/static/youjiantou.png" mode="aspectFit"></image></view>
						<text>为小毛娃撰粮</text>
					</view>
				</view>
				<view class="publish-option-column" bindtap="onPublishHelp">
					<text class="publish-option-label">发起求助</text>
					<view class="publish-option publish-option--help">
						<view class="publish-option-title-row"><text>流浪动物救助</text><image src="/static/youjiantou.png" mode="aspectFit"></image></view>
						<text>为小毛娃救治绝育</text>
					</view>
				</view>
			</view>
		</view>
	</view>
	<view class="custom-tab-bar-inner">
		<view class="tab-item {{selected === 0 ? 'active' : ''}}" data-index="0" bindtap="onTabTap">
			<text>首页</text>
		</view>
		<view class="tab-item {{selected === 1 ? 'active' : ''}}" data-index="1" bindtap="onTabTap">
			<text>自营</text>
		</view>
		<view class="tab-fab-slot" bindtap="onFabTap">
			<view class="fab-bg">
				<image class="fab-img" src="/static/fabu.png" mode="aspectFit"></image>
			</view>
		</view>
		<view class="tab-item tab-item-msg {{selected === 2 ? 'active' : ''}}" data-index="2" bindtap="onTabTap">
			<view class="tab-label-wrap">
				<text>消息</text>
				<view wx:if="{{unreadCount > 0}}" class="msg-dot"><text>{{unreadCount > 99 ? '99+' : unreadCount}}</text></view>
			</view>
		</view>
		<view class="tab-item {{selected === 3 ? 'active' : ''}}" data-index="3" bindtap="onTabTap">
			<text>我</text>
		</view>
	</view>
</view>
