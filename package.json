{
  "name": "pawhome-mini-program",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icons:scan": "node scripts/icons/scan-icons.cjs",
    "icons:build": "npm run icons:scan && node scripts/build-paw-icons.cjs",
    "icons:analyze": "node scripts/analyze-paw-icons.cjs",
    "icons:test": "node scripts/check-paw-icon-size-chain.cjs",
    "icons:audit": "npm run icons:build && npm run icons:analyze && node scripts/audit-paw-icons.cjs",
    "icons:check": "node scripts/check-paw-icons.cjs && npm run icons:test",
    "dev:mp-weixin": "npm run icons:build && npm run icons:analyze && node scripts/run-uni.cjs dev",
    "build:mp-weixin": "npm run icons:build && node scripts/run-uni.cjs build && npm run check:package",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "typecheck": "vue-tsc --noEmit",
    "check:typography": "node scripts/check-typography.cjs",
    "check:ui-governance": "node scripts/check-ui-governance.cjs",
    "check:native-ui": "node scripts/check-native-ui-reimplementation.cjs",
    "check:native-ui:strict": "node scripts/check-native-ui-reimplementation.cjs --strict",
    "check:ui": "npm run icons:test && npm run check:icon-usage && npm run check:typography && npm run check:ui-governance && npm run check:native-ui",
    "verify:ui": "npm run check:ui && npm run build:mp-weixin",
    "check:routes": "node scripts/check-page-routes.cjs",
    "test:governance": "node --test tests/governance/*.test.cjs",
    "check:icon-usage": "node scripts/check-paw-icon-usage.cjs",
    "check:figma-map": "node scripts/build-figma-state-matrix.cjs",
    "check:package-size": "node scripts/check-package-size.cjs",
    "check:assets": "node scripts/check-package-assets.cjs",
    "check:boundaries": "node scripts/check-package-boundaries.cjs",
    "check:package": "npm run check:package-size && npm run check:assets && npm run check:boundaries",
    "check:package:final": "npm run check:package-size -- --final && npm run check:assets && npm run check:boundaries"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-h5": "^3.0.0-5020420260813003",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813003",
    "vue": "^3.4.21",
    "vue-i18n": "^9.1.9"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-automator": "3.0.0-5020420260813003",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/uni-stacktracey": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@vue/runtime-core": "^3.4.21",
    "cross-env": "^10.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "json5": "^2.2.3",
    "less": "^4.4.0",
    "prettier": "^3.9.8",
    "rollup": "4.14.3",
    "sass": "^1.90.0",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "5.2.8",
    "vue-tsc": "^3.3.11",
    "yaml": "1.10.3"
  }
}
